{
	"name": "avatars.frc.sh",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "pnpm run --parallel \"/types|format|type-check|test/\"",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "oxfmt --check",
		"format:write": "oxfmt",
		"test": "vitest run",
		"type-check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"types": "wrangler types"
	},
	"dependencies": {
		"@hono/zod-openapi": "1.6.3",
		"@sentry/cloudflare": "11.6.0",
		"@sentry/hono": "11.6.0",
		"fetch-extras": "3.2.1",
		"hono": "4.13.13",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.0",
		"@msw/cloudflare": "0.1.0",
		"@types/node": "26.6.5",
		"knip": "6.41.0",
		"msw": "2.15.0",
		"oxfmt": "0.72.0",
		"typescript": "7.0.2",
		"vitest": "5.0.3",
		"wrangler": "4.149.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.11.2"
}
