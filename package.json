{
	"name": "avatars.frc.sh",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "pnpm run --parallel \"/types|format|type-check|test/\"",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "oxfmt --check",
		"format:write": "oxfmt",
		"test": "vitest run",
		"type-check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"types": "wrangler types"
	},
	"dependencies": {
		"fetch-extras": "3.2.1",
		"hono": "4.13.5",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.2",
		"@msw/cloudflare": "0.0.1",
		"@types/node": "26.4.0",
		"msw": "2.15.0",
		"oxfmt": "0.65.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.127.1"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.0.0"
}
