{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"cache": {
		"enabled": true,
	},
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/index.ts",
	"name": "avatars-frc-sh",
	"observability": {
		"enabled": true,
	},
	"r2_buckets": [
		{
			"binding": "AVATARS",
			"bucket_name": "frc-avatars",
		},
	],
	"route": {
		"custom_domain": true,
		"pattern": "avatars.frc.sh",
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"workers_dev": false,
}
